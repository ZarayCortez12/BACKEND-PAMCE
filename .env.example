# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Servidor
PORT=4000
NODE_ENV=development
# URL del frontend (CORS y enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DB_NAME=BD_PAMCE_UFPS
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Secretos de los tokens (cadenas largas y aleatorias, distintas entre sí)
JWT_SECRET=
REFRESH_SECRET=

# Correo (SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Firebase
GOOGLE_CLIENT_ID=
# Ruta al JSON de la cuenta de servicio. Si se omite, se usa src/utils/serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=
